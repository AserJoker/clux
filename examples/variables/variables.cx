// variables.cx — M1 样例：变量声明（显式标注/推断）、TDZ、const/volatile、赋值、显式丢弃
func main():i32 {
    var x:i32 = 10;          // 显式类型标注
    var y = 20;              // 类型推断
    const z:i32 = 30;        // const 修饰（M1 强制）
    volatile w:i32 = 40;     // volatile 修饰（M1 忽略）
    var t:i32 = undefined;   // TDZ：声明但未初始化

    t = x + y;               // 普通赋值（仅语句，不可链式）
    _ = z;                   // 显式丢弃表达式返回值

    printf("x = %d, t = %d\n", x, t);
    return 0;
}
